<script>
(function(){
  var input=document.getElementById('gl-search');
  var cards=[].slice.call(document.querySelectorAll('#glossary-grid .gl'));
  var count=document.getElementById('gl-count');
  var empty=document.createElement('div');
  empty.className='gl-none';
  empty.textContent='// NO MATCHING TERMS //';
  empty.style.display='none';
  document.getElementById('glossary-grid').appendChild(empty);

  function render(){
    var q=(input.value||'').trim().toLowerCase();
    var shown=0;
    cards.forEach(function(c){
      var hit=!q||c.textContent.toLowerCase().indexOf(q)!==-1;
      c.style.display=hit?'':'none';
      if(hit)shown++;
    });
    empty.style.display=shown?'none':'block';
    count.textContent=shown+' of '+cards.length+' terms';
  }
  input.addEventListener('input',render);
  render();
})();
</script>

